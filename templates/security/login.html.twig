{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    body {
        background-color: #DADADA;
    }
    body > .grid {
        height: 100%;
    }
    .image {
        margin-top: -100px;
    }
    .column {
        max-width: 450px;
    }
</style>
{% endblock %}

{% block body %}
<div class="ui middle aligned center aligned grid">
    <div class="column">
        <h2 class="ui teal image header">
            <i class="leaf icon"></i>
            <div class="content">
                Connectez-vous à votre compte
            </div>
        </h2>

        {# Affichage de l'erreur de connexion #}
        {% if error %}
            <div class="ui negative message">
                <i class="close icon"></i>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form class="ui large form" method="post" action="{{ path('app_login') }}">
            <div class="ui stacked segment">
                <div class="field">
                    <div class="ui left icon input">
                        <i class="user icon"></i>
                        <input type="email" name="_username" value="{{ last_username }}"
                               placeholder="Adresse email" required autofocus>
                    </div>
                </div>
                <div class="field">
                    <div class="ui left icon input">
                        <i class="lock icon"></i>
                        <input type="password" name="_password" placeholder="Mot de passe" required>
                    </div>
                </div>

                {# Token CSRF obligatoire pour Symfony #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="ui fluid large teal submit button">
                    Connexion
                </button>
            </div>
        </form>

        <div class="ui message">
            Pas encore de compte ? <a href="{{ path('app_register') }}">Inscrivez-vous</a>
        </div>
    </div>
</div>
{% endblock %}