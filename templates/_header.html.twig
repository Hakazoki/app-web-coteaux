{% set locales = {'fr': 'Français', 'br': 'Breizh', 'gr': 'Gromli'} %}
<div class="ui top sticky menu">
  <a href="{{ path('app_home') }}" class="active item">
    {{ 'nav.home'|trans }}
  </a>
  <div class="ui menu">
    <div class="ui category search item">
      <div class="ui transparent icon input">
        <input class="prompt" type="text" placeholder="{{ 'nav.search'|trans }}">
        <i class="search link icon"></i>
      </div>
      <div class="results"></div>
    </div>
  </div>
  <div class="right menu">
    <div class="ui dropdown item">
      <i class="globe icon"></i>
      {{ locales[app.request.locale]|default('Choisir une langue') }}
      <i class="dropdown icon"></i>
      <div class="menu">
        {% for code, label in locales %}
          <a
            class="item {{ code == app.request.locale ? 'active selected' }}"
            href="{{ path('app_locale', {locale: code}) }}"
          >{{ label }}</a>
        {% endfor %}
      </div>
    </div>
    <div class="item">
      <div class="ui primary button">{{ 'nav.signup'|trans }}</div>
    </div>
  </div>
</div>
